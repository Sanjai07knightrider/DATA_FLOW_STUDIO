# =============================================================================
# .env.example — Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# Optional SMTP settings for email sending (not required for draft generation)
# Only configure these if you want to send real emails.
# Use an App Password, never your main account password.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
